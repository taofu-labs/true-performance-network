# Bittensor
BITTENSOR=True
NETUID=0
NETWORK=finney
WALLET_COLDKEY=my-validator
WALLET_HOTKEY=default

# Competition config now lives on the leader validator (see LEADER_VALIDATOR_URL
# below for follower mode). Leader mode reads its own SQLite store directly.

# Admin API (leader mode only) — bearer token gating POST /v1/competitions.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave unset to disable the write endpoint entirely (GETs still work).
# ADMIN_API_KEY=

# Benchmark coordinator (leader mode only) — miners submit their own benchmark
# runs and commit the run ids; the leader reads those runs back to verify them.
# Reading another account's run requires ADMIN scope on the coordinator token.
# Admin scope is service-wide (it can also cancel/retry any user's runs).
# BENCHMARK_BACKEND=http
# COORDINATOR_BASE_URL=https://bench.trueperformancenetwork.com
# COORDINATOR_API_KEY=

# HuggingFace — optional, only needed on the one validator that publishes the registry
# Leave unset on all other validators; they will score normally and skip publication
# HF_TOKEN=hf_...
# HF_ORG=your-hf-org

# Validator
LAUNCH_HEALTH=True
VALIDATOR_HEALTH_PORT=9100
WEIGHT_SUBMIT_INTERVAL=1260
VALIDATOR_LOOP_INTERVAL=60
